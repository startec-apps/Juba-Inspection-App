{
  "name": "safetycheck-pro",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && rmdir /s /q docs 2>nul & xcopy dist docs /E /I /Y & copy /Y public\\CNAME docs\\CNAME & copy /Y public\\.nojekyll docs\\.nojekyll & git add docs & git commit -m \"Deploy update\" & git push"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "firebase": "^13.0.0",
    "html2pdf.js": "^0.10.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^0.20.0"
  }
}